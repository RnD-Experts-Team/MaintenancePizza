                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "amount": {
                                  "type": "string",
                                  "example": "120.00"
                                }
                              }
                            }
                          },
                          "by_category": {
