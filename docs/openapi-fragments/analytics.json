                        "type": "object",
                        "properties": {
                          "range": {
                            "type": "object",
                            "properties": {
                              "from": {
                                "type": "string"
                              },
                              "to": {
                                "type": "string"
                              },
                              "previous_from": {
                                "type": "string"
                              },
                              "previous_to": {
                                "type": "string"
                              },
                              "trend_by": {
                                "type": "string",
                                "enum": [
                                  "week",
                                  "month"
                                ]
                              }
                            }
                          },
                          "totals": {
                            "type": "object",
                            "properties": {
                              "spent": {
                                "type": "string",
                                "example": "120.00"
                              },
                              "previous_spent": {
                                "type": "string",
                                "example": "120.00"
                              },
                              "change_pct": {
                                "type": "number",
                                "nullable": true
                              },
                              "payments": {
                                "type": "integer"
                              },
                              "lines": {
                                "type": "integer"
                              }
                            }
                          },
                          "by_type": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string"
                                },
                                "label": {
                                  "type": "string"
                                },
                                "amount": {
                                  "type": "string",
                                  "example": "120.00"
                                }
                              }
                            }
                          },
                          "trend": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "period": {
                                  "type": "string"
                                },
                                "amount": {
                                  "type": "string",
                                  "example": "120.00"
                                },
                                "by_type": {
                                  "type": "object",
                                  "additionalProperties": {
                                    "type": "string",
                                    "example": "120.00"
                                  }
                                }
                              }
                            }
                          },
                          "by_store": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "store_number": {
                                  "type": "string"
                                },
                                "amount": {
                                  "type": "string",
                                  "example": "120.00"
                                }
                              }
                            }
                          },
                          "by_technician": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "category": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "integer"
                                    },
                                    "name": {
                                      "type": "string"
                                    }
                                  },
                                  "nullable": true
                                },
                                "amount": {
                                  "type": "string",
                                  "example": "120.00"
                                }
                              }
                            }
