                              "type": "object",
                              "properties": {
                                "store_number": {
                                  "type": "string"
                                },
                                "issue_id": {
                                  "type": "integer"
                                },
                                "title": {
                                  "type": "string"
                                },
                                "technicians": {
                                  "type": "integer"
                                },
                                "emergency": {
                                  "type": "integer"
                                },
                                "average_rating": {
